PORT=8787

# Bind address. Loopback by default so the proxy is unreachable from the network.
# Set 0.0.0.0 only inside a container or when you deliberately expose it — a
# non-loopback HOST without PROXY_AUTH_TOKEN fails closed (every route except
# /api/health answers 503). The server/Dockerfile sets HOST=0.0.0.0.
# HOST=127.0.0.1   # optional: the code default is already loopback; server/Dockerfile sets 0.0.0.0 for containers, and a compose env_file would override that if this line were active

# Browser origins allowed by CORS. Add your deployment origin here (for the
# docker-compose stack that is http://localhost:8080). Do not list origins you do
# not operate: every page on an allowed origin can call the proxy.
ALLOWED_ORIGINS=http://localhost:4200

# Host-header allowlist (DNS-rebinding defence). localhost, 127.0.0.1 and ::1 are
# always accepted; add the names a reverse proxy or container network uses to
# reach this service, e.g. ALLOWED_HOSTS=proxy for docker-compose.
ALLOWED_HOSTS=

# Caller authentication. When set, every /api/* route except /api/health requires
# this token (Authorization: Bearer <token> or X-Proxy-Key: <token>). The web app
# sends X-Proxy-Key from Settings > Integrations > "Proxy access token". Leave
# unset only for isolated localhost use — the proxy forwards the credentials
# below, so set a strong random value whenever it is reachable beyond 127.0.0.1.
PROXY_AUTH_TOKEN=

# OpenCTI. The proxy parses every GraphQL document before forwarding it and only
# forwards read queries whose root fields are about, indicators and threatActors
# (extend with OPENCTI_ALLOWED_QUERY_FIELDS=field1,field2). Mutations are refused
# unless OPENCTI_ALLOW_IMPORT=true, which admits exactly the web app's
# "mutation ImportStix { stixObjectOrStixRelationshipImport }" (Export to OpenCTI).
# Use a least-privileged, read-mostly OpenCTI user for OPENCTI_TOKEN.
OPENCTI_URL=https://your-opencti-instance.example
OPENCTI_TOKEN=replace-me
OPENCTI_ALLOW_IMPORT=false
OPENCTI_ALLOWED_QUERY_FIELDS=

MISP_URL=https://your-misp-instance.example
MISP_API_KEY=replace-me
MISP_ORG_ID=

# Resource limits: request body size accepted from the browser, upstream response
# timeout and the largest upstream body the proxy will relay.
MAX_BODY_SIZE=1mb
UPSTREAM_TIMEOUT_MS=30000
UPSTREAM_MAX_BYTES=10485760

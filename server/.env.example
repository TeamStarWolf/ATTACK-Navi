PORT=8787
ALLOWED_ORIGINS=http://localhost:4200,https://teamstarwolf.github.io

# Caller authentication. When set, every /api/* route except /api/health requires
# this token (Authorization: Bearer <token> or X-Proxy-Key: <token>). Leave unset
# only for isolated localhost use — the proxy forwards the credentials below, so
# set a strong random value whenever it is reachable beyond 127.0.0.1.
PROXY_AUTH_TOKEN=

OPENCTI_URL=https://your-opencti-instance.example
OPENCTI_TOKEN=replace-me

MISP_URL=https://your-misp-instance.example
MISP_API_KEY=replace-me
MISP_ORG_ID=
